# Dev backend image: Python deps baked in; source is bind-mounted for uvicorn reload.
# Includes Zscaler CA for corporate laptop Docker builds (never published to GHCR).
# Prod image: see root Dockerfile + USE_CORPORATE_CA (build-only; not in runtime).
FROM python:3.14-alpine

COPY docker/certs/zscaler-root-ca.pem /etc/ssl/certs/zscaler-root-ca.pem
# Append so apk trusts Zscaler; keep SSL_CERT_FILE for pip.
RUN cat /etc/ssl/certs/zscaler-root-ca.pem >> /etc/ssl/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/ssl/certs/zscaler-root-ca.pem \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/zscaler-root-ca.pem \
    PIP_CERT=/etc/ssl/certs/zscaler-root-ca.pem
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# bash: entrypoint-dev-backend.sh uses #!/usr/bin/env bash (alpine has no bash by default).
RUN apk add --no-cache bash

WORKDIR /app/backend
COPY backend/pyproject.toml backend/alembic.ini ./
COPY backend/plextraktbox ./plextraktbox
COPY backend/migrations ./migrations
RUN pip install --no-cache-dir -e ".[dev]"

COPY docker/entrypoint-dev-backend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
