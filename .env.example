# Copy to .env and fill in. Used by docker-compose and local backend runs.
# Phase 10 will add optional Doppler integration (`doppler run`) for maintainer dev/CI workflows.

# dev | prod. In prod, SECRET_KEY is required.
ENV=dev

# Signs session cookies and derives the token-encryption (Fernet) key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Where the SQLite DB and caches live.
DATA_DIR=./data

# Trakt API application (registered once by the app maintainer at https://trakt.tv/oauth/applications).
# End users only authorize their Trakt account via device OAuth in the UI.
# TRAKT_CLIENT_ID=...
# TRAKT_CLIENT_SECRET=...

# Optional — local API smoke tests (`mise run api-login`); never commit real values
# DEV_USER=
# DEV_EMAIL=
# DEV_PASSWORD=
# API_URL=http://localhost:8000
# API_COOKIES=cookies.txt

# Optional — dev bootstrap after wiping ./data (`mise run dev-bootstrap`)
# Run `mise run dev-export-secrets` once after UI setup to capture these from the DB.
# PLEX_URL=http://plex.local:32400
# PLEX_TOKEN=
# TMDB_API_KEY=
# LETTERBOXD_USERNAME=
# LETTERBOXD_PASSWORD=
# TRAKT_ACCESS_TOKEN=
# TRAKT_REFRESH_TOKEN=

# Optional
# LOG_LEVEL=INFO
# LOG_FORMAT=auto   # auto | json | console (dev compose sets console for colored terminal logs)
# SYNC_RUN_DELAY_SECONDS=10   # dev only: keep runs open longer to test live log streaming
# FORCE_COLOR=1     # enable ANSI colors when stderr is not a TTY (e.g. docker compose)
# HOST=0.0.0.0
# PORT=8000
