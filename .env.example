# Copy to .env and fill in. Used by docker-compose and local backend runs.

# dev | prod. In prod, MEDIA_SYNC_SECRET_KEY is required.
MEDIA_SYNC_ENV=dev

# Signs session cookies and derives the token-encryption (Fernet) key.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIA_SYNC_SECRET_KEY=

# Where the SQLite DB and caches live.
MEDIA_SYNC_DATA_DIR=./data

# Optional
# MEDIA_SYNC_LOG_LEVEL=INFO
# MEDIA_SYNC_HOST=0.0.0.0
# MEDIA_SYNC_PORT=8000
