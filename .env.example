# Local knobs + optional secrets. Used by docker-compose and local backend runs.
#
# Maintainers (recommended): keep secrets in Doppler config `local` (see docs/dev-workflow.md).
#   doppler login && doppler setup
#   mise run up-dev          # hot reload with Doppler
#   mise run up-doppler      # prod compose with Doppler
# Leave this file for non-secrets only (DATA_DIR, LOG_*, SYNC_RUN_DELAY_SECONDS, …).
#
# Without Doppler: uncomment/fill SECRET_KEY + Trakt (+ optional bootstrap vars) and use
#   mise run up-dev-env

# local | prod. In prod, SECRET_KEY is required.
ENV=local

# Where the SQLite DB and caches live.
DATA_DIR=./data

# --- Secrets (Doppler `local`, or fill here if not using Doppler) ---
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Trakt API app (https://trakt.tv/oauth/applications) — end users only do device OAuth in the UI.
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Optional — used by api-login and dev-bootstrap (never commit real values)
# DEV_USER=
# DEV_EMAIL=
# DEV_PASSWORD=
# API_URL=http://localhost:8000
# API_COOKIES=cookies.txt

# Optional — connection vars for dev-bootstrap after wiping ./data
# Capture with: mise run dev-export-secrets (then paste into Doppler).
# PLEX_URL=http://plex.local:32400
# PLEX_TOKEN=
# TMDB_API_KEY=
# LETTERBOXD_USERNAME=
# LETTERBOXD_PASSWORD=
# TRAKT_ACCESS_TOKEN=
# TRAKT_REFRESH_TOKEN=

# Optional local knobs
# LOG_LEVEL=INFO
# LOG_FORMAT=auto   # auto | json | console (dev compose sets console for colored terminal logs)
# SYNC_RUN_DELAY_SECONDS=10   # local only: keep runs open longer to test live log streaming
# FORCE_COLOR=1     # enable ANSI colors when stderr is not a TTY (e.g. docker compose)
# HOST=0.0.0.0
# PORT=8000          # HTTP listen port (compose host+container; entrypoint uvicorn). Use another value if 8000 is taken.
# USE_CORPORATE_CA=1  # Zscaler laptop: trust docker/certs during prod image npm/pip (not in runtime)
